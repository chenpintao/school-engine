<%# 首页：今日话题（OP）→ 当日精选回帖；空态克制，移动端优先 %>
<section>
  <p class="se-section-label">今日话题</p>
  <% if @topic %>
    <article class="se-card se-topic-card">
      <h1 class="se-topic-title">
        <a href="<%= @topic[:url] %>"><%= @topic[:title] %></a>
      </h1>
      <% if @topic[:excerpt].present? %>
        <p class="se-topic-excerpt"><%= @topic[:excerpt] %></p>
      <% end %>
      <a class="se-topic-link" href="<%= @topic[:url] %>">参与讨论 →</a>
    </article>
  <% else %>
    <div class="se-card se-empty">今天还没有话题，去<%= link_to("表达空间", "/c/#{SiteSetting.school_engine_expression_category}") %>看看吧。</div>
  <% end %>
</section>

<section>
  <p class="se-section-label">精选回答</p>
  <% if @featured.any? %>
    <% if @fallback %>
      <p class="se-fallback-hint">今天的精选还在路上，先看看最近被选中的回答</p>
    <% end %>
    <div class="se-featured-list">
      <% @featured.each do |post| %>
        <article class="se-card se-post-card">
          <div class="se-post-meta">
            <% if post[:anonymous] %>
              <span class="se-post-anon"><%= post[:author_name] %></span>
            <% else %>
              <a class="se-post-author" href="/u/<%= post[:username] %>"><%= post[:author_name] %></a>
            <% end %>
            <% if post[:like_count].to_i > 0 %>
              <span class="se-post-likes">★ <%= post[:like_count] %></span>
            <% end %>
          </div>
          <p class="se-post-excerpt"><%= post[:excerpt] %></p>
          <a class="se-post-link" href="<%= post[:url] %>">查看原文 →</a>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="se-card se-empty">还没有精选回答。管理员每天会从话题回复里挑选真实、有趣、有共鸣的三条。</div>
  <% end %>
</section>
