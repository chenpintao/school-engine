<!DOCTYPE html>
<html lang="<%= SiteSetting.default_locale %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title><%= SiteSetting.title %></title>
    <style>
      :root {
        --se-bg: #f7f7f5;
        --se-surface: #ffffff;
        --se-ink: #151515;
        --se-ink-soft: #6b6b66;
        --se-line: #e6e5e0;
        --se-accent: #151515;
        --se-star: #d9a400;
        --se-radius: 14px;
        --se-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--se-bg);
        color: var(--se-ink);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .se-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(247, 247, 245, 0.9);
        backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--se-line);
      }

      .se-header-inner {
        max-width: 720px;
        margin: 0 auto;
        padding: 0.7rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .se-brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 700;
        font-size: 1.05rem;
        flex: 0 0 auto;
      }

      .se-brand img {
        height: 24px;
        width: auto;
      }

      .se-nav {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-left: auto;
        font-size: 0.92rem;
        color: var(--se-ink-soft);
        white-space: nowrap;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .se-nav::-webkit-scrollbar {
        display: none;
      }

      .se-nav a:hover {
        color: var(--se-ink);
      }

      .se-nav .se-nav-user {
        color: var(--se-ink);
        font-weight: 600;
      }

      .se-main {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
      }

      .se-section-label {
        margin: 1.75rem 0 0.75rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--se-ink-soft);
      }

      .se-card {
        background: var(--se-surface);
        border: 1px solid var(--se-line);
        border-radius: var(--se-radius);
        box-shadow: var(--se-shadow);
      }

      .se-topic-card {
        padding: 1.4rem 1.35rem;
      }

      .se-topic-title {
        margin: 0;
        font-size: 1.3rem;
        line-height: 1.4;
        font-weight: 700;
      }

      .se-topic-excerpt {
        margin: 0.6rem 0 0;
        color: var(--se-ink-soft);
        font-size: 0.95rem;
      }

      .se-topic-link {
        display: inline-block;
        margin-top: 0.9rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--se-ink);
      }

      .se-featured-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      .se-post-card {
        padding: 1.1rem 1.25rem;
      }

      .se-post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--se-ink-soft);
        margin-bottom: 0.45rem;
      }

      .se-post-author {
        font-weight: 600;
        color: var(--se-ink);
      }

      .se-post-anon {
        font-weight: 600;
        color: var(--se-ink-soft);
      }

      .se-post-likes {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
      }

      .se-post-excerpt {
        margin: 0;
        font-size: 0.97rem;
      }

      .se-post-link {
        display: inline-block;
        margin-top: 0.6rem;
        font-size: 0.85rem;
        color: var(--se-ink-soft);
      }

      .se-post-link:hover {
        color: var(--se-ink);
      }

      .se-empty {
        padding: 2.4rem 1.25rem;
        text-align: center;
        color: var(--se-ink-soft);
        font-size: 0.92rem;
      }

      .se-fallback-hint {
        margin: 0 0 0.6rem;
        font-size: 0.78rem;
        color: var(--se-ink-soft);
      }

      @media screen and (max-width: 550px) {
        .se-header-inner {
          padding: 0.65rem 1rem;
          gap: 0.7rem;
        }

        .se-brand {
          font-size: 0.98rem;
        }

        .se-nav {
          gap: 0.7rem;
          font-size: 0.86rem;
        }

        .se-main {
          padding: 1.1rem 0.9rem 3rem;
        }

        .se-topic-card {
          padding: 1.15rem 1rem;
        }

        .se-topic-title {
          font-size: 1.15rem;
        }

        .se-post-card {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="se-header">
      <div class="se-header-inner">
        <a class="se-brand" href="/">
          <% if SiteSetting.logo.present? %>
            <img src="<%= SiteSetting.logo.url %>" alt="<%= SiteSetting.title %>" />
          <% else %>
            <span><%= SiteSetting.title %></span>
          <% end %>
        </a>
        <nav class="se-nav">
          <a href="/latest">最新</a>
          <a href="/categories">分类</a>
          <a href="/school/directory">同学录</a>
          <% if current_user %>
            <a class="se-nav-user" href="/u/<%= current_user.username_lower %>">
              <%= current_user.username %>
            </a>
          <% else %>
            <a href="/school/login">登录</a>
          <% end %>
        </nav>
      </div>
    </header>
    <main class="se-main"><%= yield %></main>
  </body>
</html>
